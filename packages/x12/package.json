{
  "name": "@campfhir/x12",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript library for building and parsing X12 EDI interchanges and HIPAA transaction sets (270/271, 835, 837P, 999). Runs on Node.js, Bun, browsers, and Cloudflare Workers.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./005010X231A1": {
      "types": "./dist/005010X231A1/index.d.ts",
      "default": "./dist/005010X231A1/index.js"
    },
    "./005010X231A1/*": {
      "types": "./dist/005010X231A1/*.d.ts",
      "default": "./dist/005010X231A1/*.js"
    },
    "./005010X221A1": {
      "types": "./dist/005010X221A1/index.d.ts",
      "default": "./dist/005010X221A1/index.js"
    },
    "./005010X221A1/*": {
      "types": "./dist/005010X221A1/*.d.ts",
      "default": "./dist/005010X221A1/*.js"
    },
    "./005010X222A1": {
      "types": "./dist/005010X222A1/index.d.ts",
      "default": "./dist/005010X222A1/index.js"
    },
    "./005010X222A1/*": {
      "types": "./dist/005010X222A1/*.d.ts",
      "default": "./dist/005010X222A1/*.js"
    },
    "./005010X279A1": {
      "types": "./dist/005010X279A1/index.d.ts",
      "default": "./dist/005010X279A1/index.js"
    },
    "./005010X279A1/*": {
      "types": "./dist/005010X279A1/*.d.ts",
      "default": "./dist/005010X279A1/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fixtures:fetch": "node scripts/fetch-examples.mjs"
  },
  "keywords": [
    "x12",
    "edi",
    "healthcare",
    "hipaa",
    "parser",
    "builder",
    "270",
    "271",
    "999",
    "eligibility",
    "835",
    "remittance",
    "837",
    "claims"
  ],
  "author": "Scott Eremia-Roden",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campfhir/kindling.git",
    "directory": "packages/x12"
  },
  "bugs": {
    "url": "https://github.com/campfhir/kindling/issues"
  },
  "homepage": "https://github.com/campfhir/kindling/tree/main/packages/x12#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.15.0"
}
