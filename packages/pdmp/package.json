{
  "name": "@campfhir/pdmp",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript library for building and parsing ASAP prescription drug monitoring program (PDMP) reports. Runs on Node.js, Bun, browsers, and Cloudflare Workers.",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pdmp",
    "asap",
    "prescription-monitoring",
    "healthcare",
    "pharmacy",
    "parser",
    "builder"
  ],
  "author": "Scott Eremia-Roden",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/campfhir/kindling.git",
    "directory": "packages/pdmp"
  },
  "bugs": {
    "url": "https://github.com/campfhir/kindling/issues"
  },
  "homepage": "https://github.com/campfhir/kindling/tree/main/packages/pdmp#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.15.0"
}
